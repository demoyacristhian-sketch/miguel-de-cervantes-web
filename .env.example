# Variables de entorno del proyecto. Nunca commitear valores reales: solo nombres y comentarios.

# URL pública del sitio, usada para metadata/OpenGraph/canonical.
# Sin valor por defecto en local (cae a http://localhost:3000). Configurar en Vercel
# con la URL real del Preview/Producción cuando exista (ver docs/DEPLOYMENT.md).
NEXT_PUBLIC_SITE_URL=

